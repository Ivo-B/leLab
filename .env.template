# Copy to `.env` and fill in values, or use Setup → Connect Forge in the UI.
# `.env` is gitignored and loaded by LeLab (see lelab/utils/forge_config.py).
# Shell environment variables win over `.env` on process start; the UI updates
# both the file and the running process.

# Weights & Biases (required for Forge tracking)
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=so101-kitting

# CoreWeave Sandbox (required for remote training)
CWSANDBOX_API_KEY=
CWSANDBOX_TRAIN_IMAGE=
CWSANDBOX_MAX_LIFETIME_SECONDS=14400

# Hugging Face (optional; Hub download / push from sandbox)
HF_TOKEN=

# Forge VL models (optional overrides)
# FORGE_JUDGE_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B
# FORGE_PLANNER_MODEL=nvidia/NVIDIA-Nemotron-3.5-Super-VL-120B-A12B
